# ---------- Server ----------
PORT=5000
# Comma-separated list of allowed front-end origins
CLIENT_URL=http://localhost:5173

# ---------- Security ----------
# Any long random string (>= 16 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a58dadf2ca5839cd94330a1a1706cd1296e53b6467a9e061f3ef68a5f11901247031311fccb3db7b7d4084d1a9fb752f

# ---------- Firebase Admin (ID-token verification + Firestore) ----------
# Option A (recommended): path to the service-account JSON downloaded from
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=meetsphere-cce1a
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Option B: individual values instead of a file
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Groq AI ----------
# Free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Speech-to-text used by the desktop/mobile apps (no built-in speech recogniser there)
GROQ_STT_MODEL=whisper-large-v3-turbo

# ---------- WebRTC ----------
MAX_PARTICIPANTS=6
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN relays are needed for users behind strict NATs / some mobile networks (optional for a LAN demo)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---------- Meeting features ----------
# Largest file that can be shared in a meeting (MB)
MAX_FILE_MB=5
# Set to true to require a verified email address before creating or joining meetings
REQUIRE_VERIFIED_EMAIL=false

# ---------- Email invitations (optional) ----------
# Without these the Invite dialog offers a mailto: link instead. Example for Gmail: smtp.gmail.com / 465 / true with an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MeetSphere <you@example.com>
