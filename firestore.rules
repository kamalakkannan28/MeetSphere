rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isParticipant(code) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/meetings/$(code)).data.participants;
    }

    // Meeting documents are created/updated ONLY by the backend (Admin SDK bypasses rules).
    // The 'meetingSecrets' collection (password hashes) has no rule below, so browsers can never read it.
    match /meetings/{code} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;

      // Chat messages: participants may read; may only create messages authored as themselves.
      match /messages/{id} {
        allow read: if isParticipant(code);
        allow create: if isParticipant(code)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }

      // Final speech-to-text segments, same rules.
      match /transcripts/{id} {
        allow read: if isParticipant(code);
        allow create: if isParticipant(code)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
